# 1. Inisialisasi folder
git init

# 2. Tambahkan semua file (termasuk script bot)
git add .

# 3. Commit awal
git commit -m "Initial Build KANA CORE"

# 4. Hubungkan ke akun Kingkana22 (Ganti NAMA_REPO jika beda)
git remote add origin https://github.com/Kingkana22/KANA_OMNI_AGENT.git

# 5. Kirim ke Cloud
git push -u origin master